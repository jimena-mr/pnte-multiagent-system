# Configuración de OpenAI y LLM
OPENAI_API_KEY=mock-key-for-local-testing
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Guardrails y límites
MAX_RESPONSE_CHARS=250
SYSTEM_SCOPE_REJECTION=Solo puedo ayudarte con formalización y constitución de empresas. ¿Te ayudo en algo más?

# Parámetros del PNTE y Perú
UIT_VALUE=5350
MIN_CAPITAL_PEN=1.00
NOTARY_BASE_COST=120.00

# Base de datos y persistencia
DATABASE_URL=sqlite+aiosqlite:///./pnte_database.db
TICKET_EXPIRY_HOURS=24

# Servidor y API
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
